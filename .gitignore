!.vscode/extensions.json

# ─── AI / scaffold tooling (optional — remove block to keep specs) ──────────
.kiro/
.lovable/
.cursor/

# ─── Test / coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
e2e/transport/.fixture.json
qa-artifacts/pw-*.png
qa-artifacts/pending-hold/

# Local theme / screenshot verification dumps (do not commit binaries)
apps/admin/.theme-verify-*/

# ─── Temp ───────────────────────────────────────────────────────────────────
tmp/
.temp/
