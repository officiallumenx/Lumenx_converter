/wrangler.json
/wrangler.jsonc

# ─── Environment & secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production
!.env.staging.example
!backend/.env.staging.example
*.local

# Firebase Android client configs (drop in locally / CI secrets — do not commit)
apps/*/android/app/google-services.json

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editors ──────────────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
