# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ──────────────────────────────────────────────────────────
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
build/
*.tsbuildinfo

# ─── Framework / bundler cache ──────────────────────────────────────────────
.tanstack/
.vite/
.cache/
.eslintcache
