    "./fees": "./src/fees/index.ts",
    "./exams": "./src/exams/index.ts",
    "./events": "./src/events/index.ts",
    "./transport": "./src/transport/index.ts",
    "./leave": "./src/leave/index.ts",
    "./announcements": "./src/announcements/index.ts",
    "./messages": "./src/messages/index.ts",
    "./complaints": "./src/complaints/index.ts",
    "./admissions": "./src/admissions/index.ts",
    "./careers": "./src/careers/index.ts",
    "./certificates": "./src/certificates/index.ts",
    "./documents": "./src/documents/index.ts",
    "./timetable": "./src/timetable/index.ts",
