# =============================================================================
# LumenX API — STAGING only (Admin / Connect / Transport shared backend)
# =============================================================================
# Copy to backend/.env.staging (gitignored) and fill with STAGING secrets.
# Never copy production credentials here.
# Never commit backend/.env.staging.
#
# Start:  npm run dev:staging   (or npm run start:staging after build)
# Docs:   backend/STAGING.md
# =============================================================================

# Must be exactly "staging" — enables fail-closed project confirmation checks.
LUMENX_ENV=staging

# Operator must type this exact phrase after confirming the Supabase project
# is a dedicated non-production/staging project (not prod, not shared ambiguous).
STAGING_CONFIRMED=I_CONFIRM_THIS_IS_NON_PRODUCTION

# Supabase project ref only (the subdomain before .supabase.co). Must match SUPABASE_URL.
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF

# Comma-separated production (and any other forbidden) project refs.
# If SUPABASE_URL's ref appears here, the API refuses to start in staging mode.
PRODUCTION_SUPABASE_PROJECT_REF_DENYLIST=YOUR_PRODUCTION_PROJECT_REF

# ── Environment ──────────────────────────────────────────────────────
# Keep development so production packaging gates do not force live SMS/CORS.
# Staging is identified by LUMENX_ENV=staging, not NODE_ENV=production.
NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# Include local Admin / Connect / Transport Vite origins used against staging API.
CORS_ORIGINS=http://localhost:8081,http://localhost:5174,http://localhost:5175,http://127.0.0.1:8081,http://127.0.0.1:5174,http://127.0.0.1:5175

LOG_LEVEL=info

# ── Staging Supabase (dedicated project — NOT production) ────────────
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# ── Firebase Admin (staging FCM project preferred; leave blank to disable push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ANALYTICS_MEASUREMENT_ID=
FIREBASE_CRASHLYTICS_ENABLED=false
FCM_WORKER_ENABLED=false
FCM_ALLOW_PROD_OUTBOX=false

# ── OTP (prefer demo on staging unless deliberately testing SMS) ─────
OTP_DELIVERY_MODE=demo
OTP_SMS_PROVIDER=none
OTP_EMAIL_PROVIDER=none
OTP_SMS_DEFAULT_COUNTRY_CODE=+91

# ── Nexus bootstrap (staging only; never production passwords here) ──
NEXUS_OPEN_ACCESS=0
NEXUS_BOOTSTRAP_EMAIL=
NEXUS_BOOTSTRAP_PASSWORD=

# ── Workers ──────────────────────────────────────────────────────────
SUBSCRIPTION_LIFECYCLE_SYNC_MS=3600000
BACKGROUND_JOBS_INTERVAL_MS=60000

# ── Rate limits / payments ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
ONLINE_PAYMENT_PROVIDER=none

# ── Smoke / E2E (optional; used by backend smoke scripts) ────────────
# Point at the staging API you actually started (default is local).
E2E_API_BASE_URL=http://127.0.0.1:8787
SMOKE_API_BASE_URL=http://127.0.0.1:8787
# Optional shared password for smoke.*@lumenx.test accounts (do not reuse prod passwords).
E2E_SMOKE_PASSWORD=
# verify:auth:live stays off unless you intentionally set LIVE_AUTH_VERIFY=1
# LIVE_AUTH_VERIFY=0
