{
  "name": "@lumenx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LumenX backend API — server-only workspace. Framework, integrations, and middleware are added in later phases.",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "start:tsx": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/prod-smoke.mjs",
    "migrations:list": "node scripts/list-migrations.mjs",
    "migrations:bundle": "node scripts/bundle-migrations.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.5",
    "zod": "^3.25.76"
  }
}
