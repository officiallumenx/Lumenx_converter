# ── Environment ──────────────────────────────────────────────────────
NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Supabase (leave blank for local dev without Supabase) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (leave blank for local dev without Firebase) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
