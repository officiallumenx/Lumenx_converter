# ── Environment ──────────────────────────────────────────────────────
NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Supabase (leave blank for local dev without Supabase) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase Admin (SERVER ONLY — never put these in VITE_* / frontend) ──
# Used for: Auth ID-token verify + FCM send (Admin Messaging SDK).
# Not used: Firestore, Realtime Database, Firebase Storage for LumenX data.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public client hints (safe to expose via /api/v1/auth/firebase/public-config)
FIREBASE_ANALYTICS_MEASUREMENT_ID=
# true|false — tells clients to enable Crashlytics SDK (Crashlytics is client-side)
FIREBASE_CRASHLYTICS_ENABLED=false
# true|false — verifyIdToken checkRevoked (extra Auth round-trip)
FIREBASE_AUTH_CHECK_REVOKED=false

# FCM delivery uses the Admin credentials above + Supabase tables:
#   device_token, notification_delivery_attempt (channel=fcm)
# Worker starts automatically when Supabase admin + Firebase Messaging are configured.

# ── OTP delivery (Phase 1) ───────────────────────────────────────────
# demo = no network send; fixed 123456 may appear as devOtp (dev/test only)
# live = real SMS/email via Twilio/Resend for legacy/Nexus OTP channels
# NODE_ENV=production always forces live regardless of this value.
# With VITE_AUTH_PROVIDER=firebase, Admin uses Firebase phone OTP or email/password;
# it does not use numeric email OTP.
OTP_DELIVERY_MODE=demo

# SMS: keep none when Admin/Nexus use Firebase phone OTP (client SDK).
# Only set twilio/webhook if you intentionally send server SMS (not Firebase).
OTP_SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
OTP_SMS_DEFAULT_COUNTRY_CODE=+91

# Email for staff/Nexus email OTP: none | resend | webhook
OTP_EMAIL_PROVIDER=none
RESEND_API_KEY=
OTP_EMAIL_FROM=
OTP_EMAIL_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_TOKEN=

# ── Nexus cold-start operator (not demo business data) ───────────────
# Run once: node scripts/bootstrap-nexus-operator.mjs
NEXUS_BOOTSTRAP_EMAIL=nexus.root@lumenx.local
NEXUS_BOOTSTRAP_PASSWORD=
NEXUS_BOOTSTRAP_HANDLE=nexus-root
NEXUS_BOOTSTRAP_NAME=Nexus Root
# Optional returning-login credentials; set username and PIN together.
NEXUS_BOOTSTRAP_MOBILE=
NEXUS_BOOTSTRAP_USERNAME=
NEXUS_BOOTSTRAP_PIN=
# Local/dev only — mint Nexus session without login UI (never in production).
NEXUS_OPEN_ACCESS=1

# Commercial lifecycle sync (trial → grace → read_only + overdue renewals)
# Interval in ms. Default 3600000 (1h). Set 0 to disable the background loop.
SUBSCRIPTION_LIFECYCLE_SYNC_MS=3600000

# Background jobs: scheduled announcement publish, alert-rule evaluate, diary reminders
# Interval in ms. Default 60000 (1m). Set 0 to disable.
BACKGROUND_JOBS_INTERVAL_MS=60000

# Rate limits (Phase 2 Step 9) — per client IP. Set *_MAX=0 to disable.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30

# Online subscription checkout (Phase 2 Step 10)
# none = disabled (default); demo = local session + POST /api/v1/webhooks/payments/demo
# webhook = record sessions for a real provider; confirm via signed webhook
ONLINE_PAYMENT_PROVIDER=none
ONLINE_PAYMENT_WEBHOOK_SECRET=
ONLINE_PAYMENT_CHECKOUT_BASE_URL=https://pay.lumenx.local

# ── Production packaging (NODE_ENV=production) ───────────────────────
# HOST defaults to 0.0.0.0 when unset in production.
# CORS_ORIGINS must be set explicitly to real https app origins (not localhost-only).
# Supabase + Firebase + at least one OTP provider are required or the process refuses to start.
# See backend/DEPLOY.md for Docker / PM2 / systemd / smoke.
# See backend/OPS.md for OTP, billing write-lock, and lifecycle cron runbooks.
