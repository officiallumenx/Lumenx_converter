# ── Environment ──────────────────────────────────────────────────────
NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Supabase (leave blank for local dev without Supabase) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (leave blank for local dev without Firebase) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── OTP delivery (Phase 1) ───────────────────────────────────────────
# demo = no network send (default in development/test); live = real SMS/email
# Production always sends live regardless of this value.
OTP_DELIVERY_MODE=demo

# SMS for parent login + staff mobile OTP: none | twilio | webhook
OTP_SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
OTP_SMS_DEFAULT_COUNTRY_CODE=+91

# Email for staff email OTP: none | resend | webhook
OTP_EMAIL_PROVIDER=none
RESEND_API_KEY=
OTP_EMAIL_FROM=
OTP_EMAIL_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_TOKEN=

# Commercial lifecycle sync (trial → grace → read_only + overdue renewals)
# Interval in ms. Default 3600000 (1h). Set 0 to disable the background loop.
SUBSCRIPTION_LIFECYCLE_SYNC_MS=3600000

# ── Production packaging (NODE_ENV=production) ───────────────────────
# HOST defaults to 0.0.0.0 when unset in production.
# CORS_ORIGINS must be set explicitly to real https app origins (not localhost-only).
# Supabase + Firebase + at least one OTP provider are required or the process refuses to start.
# See backend/DEPLOY.md for Docker / PM2 / systemd / smoke.
