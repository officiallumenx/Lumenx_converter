{
  "name": "@lumenx/app-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "LumenX Admin Windows desktop shell (Electron)",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64 --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.lumenx.desktop.admin",
    "productName": "LumenX Admin",
    "directories": {
      "output": "dist-out"
    },
    "files": ["src/**/*", "package.json"],
    "asar": true,
    "compression": "maximum",
    "icon": "build/icon.png",
    "win": {
      "target": ["nsis"],
      "artifactName": "LumenX-Admin-Setup.${ext}",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LumenX Admin",
      "uninstallDisplayName": "LumenX Admin",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "author": "LumenX",
  "devDependencies": {
    "electron": "35.1.2",
    "electron-builder": "25.1.8"
  }
}
