# LumenX Connect — environment template
#
# Copy to apps/connect/.env for local overrides.
# Vite embeds VITE_* at build time.

# Auth mode: demo (localStorage) | api (Supabase + /api/v1/*)
VITE_CONNECT_AUTH_MODE=demo

# Backend API (required when VITE_CONNECT_AUTH_MODE=api)
VITE_API_BASE_URL=

# Supabase Auth (required when VITE_CONNECT_AUTH_MODE=api)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Standalone Careers app origin (hard redirect from /careers)
VITE_CAREERS_ORIGIN=

# Standalone Admissions app origin (hard redirect from /admissions)
VITE_ADMISSIONS_ORIGIN=
