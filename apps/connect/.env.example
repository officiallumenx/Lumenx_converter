# LumenX Connect — environment template
#
# Copy to apps/connect/.env for local overrides.
# Vite embeds VITE_* at build time.

# Auth mode — API only. "demo" is rejected at boot.
VITE_CONNECT_AUTH_MODE=api

# Interactive identity provider: firebase (default) | supabase (legacy rollback)
VITE_AUTH_PROVIDER=firebase

# Backend API (required)
VITE_API_BASE_URL=http://127.0.0.1:8787

# Supabase Auth (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase web (required when VITE_AUTH_PROVIDER=firebase) — public only
VITE_FIREBASE_API_KEY=AIzaSyBl3yrf7F19CvhJBx_awMfUh7WvfyrsYc0
VITE_FIREBASE_AUTH_DOMAIN=lumenx-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lumenx-2026
VITE_FIREBASE_APP_ID=1:197601219106:web:8b1270e698960f3e99307b
# FCM web push
VITE_FIREBASE_MESSAGING_SENDER_ID=197601219106
VITE_FIREBASE_VAPID_KEY=BCttYAP_J2kyBaEKOlVdy4Lk3NXEUs_bt1025eO__ioQFUCk0ACvWlG4_s_gJ7wy8Hp2UlLMK93JzH5-6TiWeIU
# Analytics + Crashlytics (no business PII)
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_CRASHLYTICS_ENABLED=
VITE_APP_RELEASE=
VITE_FIREBASE_STORAGE_BUCKET=lumenx-2026.firebasestorage.app

# Standalone Careers app origin (hard redirect from /careers)
VITE_CAREERS_ORIGIN=http://localhost:5176

# Standalone Admissions app origin (hard redirect from /admissions)
VITE_ADMISSIONS_ORIGIN=http://localhost:5177
