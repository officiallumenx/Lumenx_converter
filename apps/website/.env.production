# Baked into production builds (local + Cloudflare Workers Builds).
# Keep VITE_NOINDEX unset here — lumenxtech.in must stay crawlable.
VITE_SITE_ORIGIN=https://lumenxtech.in
VITE_ADMIN_ORIGIN=https://admin.lumenxtech.in
VITE_CONNECT_ORIGIN=https://connect.lumenxtech.in
VITE_TRANSPORT_ORIGIN=https://transport.lumenxtech.in
VITE_NEXUS_ORIGIN=https://nexus.lumenxtech.in

# Native downloads via Cloudflare edge cache (GitHub Release upstream: downloads-v1.0.1).
# Switch to https://downloads.lumenxtech.in once R2 + DNS are enabled.
VITE_ADMIN_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/admin.apk
VITE_NEXUS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/nexus.apk
VITE_CONNECT_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/connect.apk
VITE_TRANSPORT_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/transport.apk
VITE_ADMISSIONS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/admissions.apk
VITE_CAREERS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/careers.apk
VITE_ADMIN_DESKTOP_URL=https://lumenx-downloads.official-lumenx.workers.dev/windows/admin-setup.exe
VITE_NEXUS_DESKTOP_URL=https://lumenx-downloads.official-lumenx.workers.dev/windows/nexus-setup.exe
