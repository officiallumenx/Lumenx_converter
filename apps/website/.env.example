# Public marketing URLs (safe to expose in the browser)
# Override defaults in src/data/downloads.js when the canonical CDN is ready.

PUBLIC_DOWNLOADS_HOST=https://lumenx-downloads.official-lumenx.workers.dev

PUBLIC_ADMIN_WEB_URL=https://admin.lumenxtech.in
PUBLIC_CAREERS_WEB_URL=https://careers.lumenxtech.in
PUBLIC_ADMISSIONS_WEB_URL=https://admissions.lumenxtech.in

PUBLIC_ADMIN_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/admin.apk
PUBLIC_CONNECT_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/connect.apk
PUBLIC_TRANSPORT_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/transport.apk
PUBLIC_CAREERS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/careers.apk
PUBLIC_ADMISSIONS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/admissions.apk
PUBLIC_NEXUS_APK_URL=https://lumenx-downloads.official-lumenx.workers.dev/android/nexus.apk

PUBLIC_ADMIN_DESKTOP_URL=https://lumenx-downloads.official-lumenx.workers.dev/windows/admin-setup.exe
PUBLIC_NEXUS_DESKTOP_URL=https://lumenx-downloads.official-lumenx.workers.dev/windows/nexus-setup.exe

# Optional Play Store listings (preferred over APK when set)
# PUBLIC_ADMIN_PLAY_URL=
# PUBLIC_CONNECT_PLAY_URL=

# Preferred: browser-side Web3Forms (public by design; free plan).
# Set locally in gitignored `.env`, and in Cloudflare Pages → Environment variables
# (Preview + Production) as a *build-time* variable so Astro can embed it in forms.
# PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Optional Cloudflare Pages Function secrets (functions/api/enquiry.js + leads.js) ---
# Server-side Web3Forms may require a paid plan / IP allowlisting. Prefer PUBLIC_ above.
# Set in Pages → Settings → Environment variables. Never commit values:
# LEAD_EMAIL_TO=lumenxtech.official@gmail.com
# WEB3FORMS_ACCESS_KEY=
# RESEND_API_KEY=
# LEAD_EMAIL_FROM=LumenX Website <onboarding@resend.dev>
#
# Without PUBLIC_WEB3FORMS_ACCESS_KEY and without Function secrets, forms fail closed
# with a clear error (no FormSubmit fallback).
