---
import { PRODUCTS } from "../data/lumenx.js";

/**
 * Present institutional modules in the Ecosystem grid.
 * LumenX Nexus is presented in its own dedicated Central Service Platform section
 * rather than as just another institutional module card.
 */
const ecosystemModules = PRODUCTS.filter((product) => product.id !== "nexus");
---

<!-- ====== Section 3: LumenX Ecosystem Start ====== -->
<section id="platform" class="lx-section lx-section--products bg-white dark:bg-dark" aria-labelledby="lx-ecosystem-heading">
  <div class="container">
    <div class="lx-section-intro mx-auto max-w-[640px] text-center" data-reveal>
      <span class="lx-section-eyebrow">LumenX Ecosystem</span>
      <h2 id="lx-ecosystem-heading" class="lx-section-title">
        Purpose-built modules for every part of your institution.
      </h2>
      <p class="lx-section-lead">
        Manage institutional operations in <strong>Admin</strong>, connect parents, teachers, and students in <strong>Connect</strong>, simplify transport operations in <strong>Transport</strong>, and streamline intake and hiring.
      </p>
    </div>

    <div class="lx-product-grid" data-stagger>
      {
        ecosystemModules.map((product) => (
          <a
            href={product.href}
            class="lx-card lx-product-card group"
            data-reveal
          >
            <div class="lx-shot-stage lx-product-card__media aspect-[16/10]">
              {product.image && (
                <div class="lx-shot-frame">
                  <img
                    src={product.image}
                    alt={product.imageAlt || product.name}
                    class="lx-shot"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="500"
                  />
                </div>
              )}
            </div>

            <div class="lx-product-card__body">
              <div class="mb-3 flex items-center gap-3">
                {product.logo && (
                  <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-stroke/80 bg-white shadow-sm dark:border-dark-3">
                    <img
                      src={product.logo}
                      alt={`${product.name} logo`}
                      class="h-full w-full object-contain"
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
                <div class="min-w-0">
                  <span class="lx-product-card__label !mb-0.5 block">{product.category}</span>
                  <h3 class="lx-product-card__title !mb-0">{product.name}</h3>
                </div>
              </div>
              <p class="lx-product-card__body-text">{product.body}</p>
              <span class="lx-card-cta lx-product-card__cta">Explore {product.shortName} →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
<!-- ====== Section 3: LumenX Ecosystem End ====== -->
