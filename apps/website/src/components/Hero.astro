---
---

<!-- ====== Hero Section Start -->
<section
  id="home"
  class="relative overflow-hidden bg-primary pt-[120px] md:pt-[130px] lg:pt-[160px]"
>
  <div class="hero-ambient" aria-hidden="true"></div>
  <div class="container">
    <div class="-mx-4 flex flex-wrap items-center hero-stage">
      <div class="w-full px-4">
        <div class="hero-content mx-auto max-w-[780px] text-center">
          <p class="hero-eyebrow mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-white/80">
            INSTITUTE MANAGEMENT ECOSYSTEM
          </p>
          <h1
            class="hero-title mb-6 text-3xl font-bold leading-snug text-white sm:text-4xl sm:leading-snug lg:text-5xl lg:leading-[1.2]"
          >
            One connected ecosystem. Smarter institutions.
          </h1>
          <p
            class="hero-copy mx-auto mb-9 max-w-[640px] font-medium text-base text-white sm:text-lg sm:leading-[1.44]"
          >
            From academics and administration to communication, transport, admissions, and hiring — LumenX brings your institution's essential workflows together.
          </p>
          <ul class="hero-actions mb-10 flex flex-wrap items-center justify-center gap-5">
            <li>
              <a
                href="/contact?intent=demo#enquiry"
                class="lx-btn inline-flex items-center justify-center rounded-md bg-white px-7 py-[14px] text-center text-base font-medium text-dark shadow-1 transition duration-300 ease-in-out hover:bg-gray-2 hover:text-body-color"
              >
                Book a Demo
              </a>
            </li>
            <li>
              <a
                href="/platform"
                class="lx-btn flex items-center gap-4 rounded-md bg-white/[0.12] px-6 py-[14px] text-base font-medium text-white transition duration-300 ease-in-out hover:bg-white hover:text-dark"
              >
                Explore the Platform
                <span aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="w-full px-4">
        <div class="hero-preview relative z-10 mx-auto max-w-[845px]">
          <div class="hero-preview-frame mt-16 overflow-hidden rounded-t-xl bg-white shadow-2">
            <img
              src="/assets/hero/hero-dashboard.png"
              alt="LumenX Admin dashboard showing institute overview, attendance, and operations"
              class="mx-auto block h-auto w-full max-w-full object-contain object-top"
              width="1918"
              height="1054"
              fetchpriority="high"
            />
          </div>
          <div class="absolute -left-9 bottom-0 z-[-1]">
            <svg width="134" height="106" viewBox="0 0 134 106" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              {Array.from({ length: 10 }).map((_, col) =>
                Array.from({ length: 8 }).map((_, row) => (
                  <circle
                    cx={1.66667 + col * 14.6667}
                    cy={104 - row * 14.6667}
                    r="1.66667"
                    transform={`rotate(-90 ${1.66667 + col * 14.6667} ${104 - row * 14.6667})`}
                    fill="white"
                  />
                ))
              )}
            </svg>
          </div>
          <div class="absolute -right-6 -top-6 z-[-1]">
            <svg width="134" height="106" viewBox="0 0 134 106" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              {Array.from({ length: 10 }).map((_, col) =>
                Array.from({ length: 8 }).map((_, row) => (
                  <circle
                    cx={1.66667 + col * 14.6667}
                    cy={104 - row * 14.6667}
                    r="1.66667"
                    transform={`rotate(-90 ${1.66667 + col * 14.6667} ${104 - row * 14.6667})`}
                    fill="white"
                  />
                ))
              )}
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Hero Section End -->
