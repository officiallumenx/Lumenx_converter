---
---

<!-- ====== Section 1: Hero Start ====== -->
<section
  id="home"
  class="relative overflow-hidden border-b border-stroke/60 bg-gradient-to-b from-[#F8FAFC] to-white pt-[108px] pb-14 dark:border-dark-3 dark:from-[#0B132B] dark:via-[#111928] dark:to-[#111928] sm:pt-[124px] sm:pb-16 lg:pt-[144px] lg:pb-20"
>
  <div class="container">
    <div class="hero-stage mx-auto max-w-[1080px]">
      <div class="hero-content mx-auto max-w-[760px] text-center">
        <span class="hero-eyebrow mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/[0.06] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.1em] text-primary dark:border-primary/30 dark:bg-primary/15 dark:text-sky-300 sm:text-[13px]">
          <span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-sky-400" aria-hidden="true"></span>
          Institutional Operations Platform
        </span>

        <h1 class="hero-title mb-5 font-heading font-bold text-dark dark:text-white">
          One Connected Ecosystem for Smarter Institutions.
        </h1>

        <p class="hero-copy mx-auto mb-8 max-w-[620px] text-[15px] leading-relaxed text-body-color dark:text-dark-6 sm:text-[17px] sm:leading-[1.65]">
          Manage your institution, connect teachers and parents, and simplify everyday operations through one integrated digital platform.
        </p>

        <div class="hero-actions mb-10 flex flex-col items-stretch justify-center gap-3 sm:mb-12 sm:flex-row sm:items-center sm:gap-4">
          <a
            href="/platform"
            class="lx-btn inline-flex items-center justify-center rounded-lg bg-primary px-7 py-3.5 text-center font-semibold text-white shadow-sm transition hover:bg-blue-dark"
          >
            Explore LumenX
          </a>
          <a
            href="/contact"
            class="lx-btn inline-flex items-center justify-center rounded-lg border border-stroke bg-white px-7 py-3.5 text-center font-semibold text-dark transition hover:border-primary hover:text-primary dark:border-dark-3 dark:bg-dark-2 dark:text-white dark:hover:border-primary"
          >
            Contact Us
          </a>
        </div>
      </div>

      <div class="hero-preview relative z-10 mx-auto max-w-[960px]">
        <div class="hero-preview-frame overflow-hidden rounded-xl border border-stroke bg-white p-1.5 shadow-lg dark:border-dark-3 dark:bg-dark-2 sm:rounded-2xl sm:p-2.5">
          <img
            src="/assets/hero/hero-dashboard.png"
            alt="LumenX Admin dashboard showing institutional overview, attendance, and daily operations"
            class="mx-auto block h-auto w-full max-w-full rounded-lg object-contain object-top"
            width="1918"
            height="1054"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Section 1: Hero End ====== -->
