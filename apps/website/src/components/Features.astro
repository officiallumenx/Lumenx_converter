<!-- ====== Section 4: Why LumenX Start ====== -->
<section id="features" class="lx-section bg-gray-1 dark:bg-dark-2" aria-labelledby="lx-why-heading">
  <div class="container">
    <div class="lx-section-intro mx-auto max-w-[600px] text-center" data-reveal>
      <span class="lx-section-eyebrow">Why LumenX</span>
      <h2 id="lx-why-heading" class="lx-section-title">
        Designed for clarity, reliability, and everyday ease.
      </h2>
      <p class="lx-section-lead">
        Five core advantages that help institutions run smoother days without software complexity.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-stagger>
      {
        advantages.map((item) => (
          <div
            class="lx-card flex flex-col rounded-xl border border-stroke bg-white p-6 shadow-1 dark:border-dark-3 dark:bg-dark sm:p-7"
            data-reveal
          >
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-white">
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="mb-2.5 font-heading text-lg font-bold text-dark dark:text-white sm:text-xl">
              {item.title}
            </h3>
            <p class="flex-1 text-sm leading-relaxed text-body-color dark:text-dark-6 sm:text-[15px]">
              {item.description}
            </p>
          </div>
        ))
      }

      <!-- 6th summary card linking to full modules & pricing -->
      <div
        class="lx-card flex flex-col justify-between rounded-xl border border-primary/20 bg-[#F4F7FF] p-6 dark:border-primary/30 dark:bg-dark sm:p-7"
        data-reveal
      >
        <div>
          <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-wider text-primary">
            Explore Capabilities
          </span>
          <h3 class="mb-2.5 font-heading text-lg font-bold text-dark dark:text-white sm:text-xl">
            12 integrated campus modules.
          </h3>
          <p class="mb-5 text-sm leading-relaxed text-body-color dark:text-dark-6 sm:text-[15px]">
            See all academic, administrative, transport, admission, and recruitment capabilities—or calculate your institution's plan.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/modules"
            class="inline-flex items-center text-sm font-semibold text-primary hover:underline"
          >
            View All Modules →
          </a>
          <span class="text-stroke dark:text-dark-3" aria-hidden="true">|</span>
          <a
            href="/pricing"
            class="inline-flex items-center text-sm font-semibold text-dark hover:text-primary dark:text-white"
          >
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Section 4: Why LumenX End ====== -->
