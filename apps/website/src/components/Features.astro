---
import { CAPABILITIES } from "../data/lumenx.js";

const icons = [
  "assets/features/icon-01.svg",
  "assets/features/icon-02.svg",
  "assets/features/icon-03.svg",
  "assets/features/icon-04.svg",
];

const features = CAPABILITIES.map((cap, i) => ({
  icon: icons[i % icons.length],
  title: cap.title,
  ref: cap.href,
  refTitle: "Learn More",
  description: cap.description,
}));
---

<!-- ====== Features Section Start -->
<section id="features" class="pt-20 pb-8 lg:pt-[120px] lg:pb-[70px] dark:bg-dark">
  <div class="container">
    <div class="-mx-4 flex flex-wrap">
      <div class="w-full px-4">
        <div class="mb-12 mx-auto max-w-[560px] lg:mb-[70px] text-center" data-reveal>
          <span class="mb-2 block text-lg font-semibold text-primary">
            Capabilities
          </span>
          <h2 class="mb-3 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]">
            Practical modules for the institute day.
          </h2>
          <p class="text-base text-body-color dark:text-dark-6">
            Academics, administration, fees, attendance, campus communication, transport, admissions, and hiring — workflows institutions already run, connected in one ecosystem.
          </p>
        </div>
      </div>
    </div>
    <div class="-mx-4 flex flex-wrap" data-stagger>
      {
        features.map((feature) => (
          <div class="w-full px-4 sm:w-1/2 lg:w-1/3 xl:w-1/4">
            <div class="wow fadeInUp group mb-12" data-wow-delay=".1s">
              <div class="relative z-10 mb-8 flex h-[70px] w-[70px] items-center justify-center rounded-[14px] bg-primary">
                <span class="absolute top-0 left-0 -z-[1] mb-8 flex h-[70px] w-[70px] rotate-[25deg] items-center justify-center rounded-[14px] bg-primary bg-opacity-20 duration-300 group-hover:rotate-45"></span>
                <img src={feature.icon} alt="" />
              </div>
              <h4 class="mb-3 text-xl font-bold text-dark dark:text-white">
                {feature.title}
              </h4>
              <p class="mb-6 text-body-color dark:text-dark-6 lg:mb-8">
                {feature.description}
              </p>
              <a
                href={feature.ref}
                class="text-base font-medium text-dark dark:text-white hover:text-primary dark:hover:text-primary"
              >
                {feature.refTitle}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
<!-- ====== Features Section End -->
