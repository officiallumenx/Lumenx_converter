---
import { NAV } from "../../data/lumenx.js";

const menuitems = [
  { title: "Home", path: "/" },
  ...NAV,
  { title: "About", path: "/about" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(itemPath: string) {
  if (!itemPath || itemPath === "javascript:void(0)") {
    return pathname.startsWith("/solutions");
  }
  const clean = itemPath.replace(/\/$/, "") || "/";
  if (clean === "/") return pathname === "/";
  return pathname === clean || pathname.startsWith(`${clean}/`);
}
---

<header
  class="ud-header absolute top-0 left-0 z-40 flex w-full items-center border-b border-stroke/80 bg-white/95 backdrop-blur-md transition-colors dark:border-dark-3 dark:bg-dark/95"
>
  <div class="mx-auto w-full max-w-[1360px] px-4 sm:px-6 lg:px-8">
    <div class="lx-header-bar relative flex min-h-[68px] w-full items-center justify-between gap-3 sm:min-h-[72px] xl:min-h-[74px] xl:gap-5 2xl:gap-8">
      <!-- Region 1: Independent Brand Container (fixed width, never shrinks or overlaps) -->
      <div class="lx-brand-region flex min-w-[144px] shrink-0 items-center">
        <a
          href="/"
          class="navbar-logo inline-flex shrink-0 items-center gap-2.5 py-2 focus:outline-none"
          aria-label="LumenX home"
        >
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-stroke/60 bg-white p-0.5 shadow-sm dark:border-dark-3">
            <img
              src="/assets/logo/lumenx-mark.png"
              alt=""
              class="header-logo h-full w-full object-contain object-center"
              width="36"
              height="36"
              aria-hidden="true"
            />
          </span>
          <span class="lx-logo-word whitespace-nowrap font-heading text-[18px] font-bold leading-none tracking-tight text-dark dark:text-white sm:text-[19px]">
            LumenX
          </span>
        </a>
      </div>

      <!-- Region 2: Center Navigation (single row on xl+ screens; drawer on <1140px) -->
      <nav
        id="navbarCollapse"
        aria-label="Primary"
        class="lx-nav absolute right-0 left-0 top-[calc(100%+0.375rem)] z-30 hidden max-h-[calc(100vh-5rem)] overflow-y-auto rounded-xl border border-stroke bg-white p-3.5 shadow-xl dark:border-dark-3 dark:bg-dark-2 sm:left-auto sm:w-[22rem] xl:static xl:z-auto xl:flex xl:max-h-none xl:flex-1 xl:items-center xl:justify-center xl:overflow-visible xl:border-0 xl:bg-transparent xl:p-0 xl:shadow-none dark:xl:bg-transparent"
      >
        <ul class="lx-nav-list flex flex-col gap-0.5 xl:flex-row xl:flex-nowrap xl:items-center xl:justify-center xl:gap-0.5 2xl:gap-1.5">
          {
            menuitems.map((item) => {
              const active = isActive(item.path);
              if (!item.children) {
                return (
                  <li class="shrink-0">
                    <a
                      href={item.path}
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "lx-nav-link ud-menu-scroll relative inline-flex w-full items-center whitespace-nowrap rounded-lg px-3 py-2.5 text-[14px] font-medium leading-none transition-colors duration-150 xl:h-9 xl:w-auto xl:px-2.5 xl:py-0 2xl:px-3",
                        active
                          ? "active bg-primary/[0.08] font-semibold text-primary xl:bg-transparent dark:bg-primary/20 dark:text-primary dark:xl:bg-transparent"
                          : "text-dark/85 hover:bg-gray-1 hover:text-primary xl:hover:bg-transparent dark:text-white/85 dark:hover:bg-dark-3/50 dark:hover:text-white dark:xl:hover:bg-transparent",
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              }
              return (
                <li class="submenu-item group relative shrink-0">
                  <a
                    href={item.path === "javascript:void(0)" ? "/solutions" : item.path}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "lx-nav-link ud-menu-scroll relative inline-flex w-full items-center justify-between gap-1 whitespace-nowrap rounded-lg px-3 py-2.5 text-[14px] font-medium leading-none transition-colors duration-150 xl:h-9 xl:w-auto xl:justify-start xl:px-2.5 xl:py-0 2xl:px-3",
                      active
                        ? "active bg-primary/[0.08] font-semibold text-primary xl:bg-transparent dark:bg-primary/20 dark:text-primary dark:xl:bg-transparent"
                        : "text-dark/85 hover:bg-gray-1 hover:text-primary xl:hover:bg-transparent dark:text-white/85 dark:hover:bg-dark-3/50 dark:hover:text-white dark:xl:hover:bg-transparent",
                    ]}
                    aria-haspopup="true"
                  >
                    <span class="whitespace-nowrap">{item.title}</span>
                    <svg
                      class="h-3.5 w-3.5 shrink-0 transition-transform duration-150 group-hover:translate-y-[1px]"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 6l4 4 4-4" />
                    </svg>
                  </a>
                  <div class="submenu relative top-full left-0 mt-1 hidden w-full rounded-lg border border-stroke/70 bg-gray-1 p-1.5 dark:border-dark-3 dark:bg-dark xl:invisible xl:absolute xl:left-0 xl:top-[calc(100%+0.375rem)] xl:mt-0 xl:block xl:w-[228px] xl:rounded-xl xl:border xl:border-stroke xl:bg-white xl:p-2 xl:opacity-0 xl:shadow-lg dark:xl:border-dark-3 dark:xl:bg-dark-2 xl:group-hover:visible xl:group-hover:opacity-100 xl:group-focus-within:visible xl:group-focus-within:opacity-100">
                    {item.children.map((child) => {
                      const childActive = pathname === child.path;
                      return (
                        <a
                          href={child.path}
                          class:list={[
                            "block rounded-lg px-3 py-2 text-[14px] transition-colors",
                            childActive
                              ? "bg-primary/[0.08] font-semibold text-primary dark:bg-primary/20 dark:text-white"
                              : "font-medium text-dark/85 hover:bg-gray-1 hover:text-primary dark:text-dark-6 dark:hover:bg-dark-3/60 dark:hover:text-white",
                          ]}
                        >
                          {child.title}
                        </a>
                      );
                    })}
                  </div>
                </li>
              );
            })
          }

          <!-- Mobile / Tablet menu actions & neatly integrated theme toggle -->
          <li class="mt-3 space-y-2.5 border-t border-stroke pt-3.5 dark:border-dark-3 xl:hidden">
            <div class="grid grid-cols-2 gap-2">
              <a
                href="/login"
                class="inline-flex min-h-[42px] items-center justify-center rounded-lg border border-stroke bg-white px-3 py-2 text-sm font-semibold text-dark transition hover:border-primary hover:text-primary dark:border-dark-3 dark:bg-dark dark:text-white"
              >
                Login
              </a>
              <a
                href="/contact"
                class="inline-flex min-h-[42px] items-center justify-center rounded-lg border border-stroke bg-white px-3 py-2 text-sm font-semibold text-dark transition hover:border-primary hover:text-primary dark:border-dark-3 dark:bg-dark dark:text-white"
              >
                Contact Us
              </a>
            </div>
            <a
              href="/platform"
              class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-dark"
            >
              Explore LumenX
            </a>

            <!-- Mobile Theme Toggle inside menu -->
            <div class="flex items-center justify-between rounded-lg bg-gray-1 px-3.5 py-2.5 dark:bg-dark">
              <span class="text-xs font-medium text-body-color dark:text-dark-6">
                Appearance
              </span>
              <button
                type="button"
                data-theme-toggle
                class="inline-flex items-center gap-2 rounded-md border border-stroke bg-white px-3 py-1.5 text-xs font-semibold text-dark shadow-sm transition hover:border-primary hover:text-primary dark:border-dark-3 dark:bg-dark-2 dark:text-white"
                aria-label="Toggle Light and Dark Mode"
                title="Switch between Light and Dark mode"
              >
                <span class="inline-flex items-center gap-1.5 dark:hidden">
                  <svg class="h-3.5 w-3.5 text-dark/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                  </svg>
                  <span>Dark mode</span>
                </span>
                <span class="hidden items-center gap-1.5 dark:inline-flex">
                  <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="5" />
                    <line x1="12" y1="1" x2="12" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="23" />
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                    <line x1="1" y1="12" x2="3" y2="12" />
                    <line x1="21" y1="12" x2="23" y2="12" />
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                  </svg>
                  <span>Light mode</span>
                </span>
              </button>
            </div>
          </li>
        </ul>
      </nav>

      <!-- Region 3: Right Actions (Login, Contact Us, Explore LumenX, and Theme Toggle LAST) -->
      <div class="lx-header-actions ml-auto flex shrink-0 items-center gap-2 xl:ml-0">
        <div class="hidden items-center xl:flex xl:gap-1 2xl:gap-2">
          <a
            href="/login"
            class="loginBtn inline-flex h-9 items-center justify-center whitespace-nowrap rounded-lg px-2 text-[14px] font-medium text-dark/85 transition-colors hover:bg-gray-1 hover:text-primary dark:text-white/85 dark:hover:bg-dark-3/60 dark:hover:text-white 2xl:px-2.5"
          >
            Login
          </a>
          <a
            href="/contact"
            class="inline-flex h-9 items-center justify-center whitespace-nowrap rounded-lg px-2 text-[14px] font-medium text-dark/85 transition-colors hover:bg-gray-1 hover:text-primary dark:text-white/85 dark:hover:bg-dark-3/60 dark:hover:text-white 2xl:px-2.5"
          >
            Contact Us
          </a>
          <a
            href="/platform"
            class="signUpBtn ml-1 inline-flex h-9 items-center justify-center whitespace-nowrap rounded-lg bg-primary px-3.5 text-[14px] font-semibold text-white shadow-sm transition hover:bg-blue-dark 2xl:px-4"
          >
            Explore LumenX
          </a>

          <!-- Theme toggle: LAST item at the extreme right on desktop -->
          <span class="mx-1 h-4 w-px shrink-0 bg-stroke dark:bg-dark-3" aria-hidden="true"></span>
          <button
            id="themeSwitcher"
            type="button"
            data-theme-toggle
            title="Switch between Light and Dark mode"
            aria-label="Switch between Light and Dark mode"
            class="lx-theme-btn inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-stroke/80 bg-transparent text-body-color transition-colors hover:border-primary/40 hover:bg-gray-1 hover:text-dark dark:border-dark-3 dark:text-dark-6 dark:hover:border-dark-3 dark:hover:bg-dark-2 dark:hover:text-white"
          >
            <!-- Moon icon shown in Light Mode (click to switch to Dark Mode) -->
            <span class="block dark:hidden" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
            </span>
            <!-- Sun icon shown in Dark Mode (click to switch to Light Mode) -->
            <span class="hidden dark:block" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5" />
                <line x1="12" y1="1" x2="12" y2="3" />
                <line x1="12" y1="21" x2="12" y2="23" />
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                <line x1="1" y1="12" x2="3" y2="12" />
                <line x1="21" y1="12" x2="23" y2="12" />
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
              </svg>
            </span>
          </button>
        </div>

        <!-- Mobile / Tablet Hamburger button (< 1140px) -->
        <button
          id="navbarToggler"
          type="button"
          class="relative inline-flex h-10 w-10 shrink-0 flex-col items-center justify-center rounded-lg border border-stroke/80 bg-white text-dark transition hover:bg-gray-1 focus:outline-none focus:ring-2 focus:ring-primary/30 dark:border-dark-3 dark:bg-dark-2 dark:text-white xl:hidden"
          aria-label="Toggle navigation"
          aria-controls="navbarCollapse"
          aria-expanded="false"
        >
          <span class="relative my-[2.5px] block h-[2px] w-[18px] bg-dark transition-all dark:bg-white"></span>
          <span class="relative my-[2.5px] block h-[2px] w-[18px] bg-dark transition-all dark:bg-white"></span>
          <span class="relative my-[2.5px] block h-[2px] w-[18px] bg-dark transition-all dark:bg-white"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .lx-header-bar {
    flex-wrap: nowrap;
  }

  .lx-brand-region,
  .lx-header-actions {
    flex: 0 0 auto;
  }

  @media (min-width: 1140px) {
    .lx-nav {
      flex: 1 1 auto;
      min-width: max-content;
    }

    .lx-nav-list {
      flex-wrap: nowrap !important;
    }

    .lx-nav-list > li > a {
      white-space: nowrap;
    }
  }
</style>
