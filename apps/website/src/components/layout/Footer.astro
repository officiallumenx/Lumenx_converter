---
import { PRODUCTS, ROLES, SITE } from "../../data/lumenx.js";

const footerLinks = [
  {
    header: "Platform",
    links: PRODUCTS.map((p) => ({
      name: p.shortName,
      href: p.href,
      isExternal: false,
    })),
  },
  {
    header: "Solutions",
    links: ROLES.map((r) => ({
      name: r.title,
      href: r.href,
      isExternal: false,
    })),
  },
  {
    header: "Company",
    links: [
      { name: "About", href: "/about", isExternal: false },
      { name: "Modules", href: "/modules", isExternal: false },
      { name: "Pricing", href: "/pricing", isExternal: false },
      { name: "Downloads", href: "/downloads", isExternal: false },
      { name: "Resources", href: "/resources", isExternal: false },
      { name: "Contact", href: "/contact", isExternal: false },
      { name: "Get Started", href: "/get-started", isExternal: false },
      { name: "Login", href: "/login", isExternal: false },
    ],
  },
];
---

<footer
  class="wow fadeInUp relative z-10 bg-[#090E34] pt-20 lg:pt-[100px]"
  data-wow-delay=".15s"
>
  <div class="container">
    <div class="-mx-4 flex flex-wrap">
      <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-4/12 xl:w-3/12">
        <div class="mb-10 w-full">
          <a href="/" class="mb-6 inline-block max-w-[160px]">
            <img
              src="/assets/logo/lumenx-logo-white.svg"
              alt="LumenX"
              class="max-w-full"
            />
          </a>
          <p class="mb-8 max-w-[270px] text-base text-gray-7">
            {SITE.description}
          </p>
        </div>
      </div>
      {
        footerLinks.map((column) => (
          <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-2/12 xl:w-2/12">
            <div class="mb-10 w-full">
              <h4 class="mb-9 text-lg font-semibold text-white">{column.header}</h4>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="mb-3 inline-block text-base text-gray-7 hover:text-primary"
                      target={link.isExternal ? "_blank" : undefined}
                      rel={link.isExternal ? "noopener noreferrer" : undefined}
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <div class="w-full px-4 md:w-2/3 lg:w-6/12 xl:w-3/12">
        <div class="mb-10 w-full">
          <h4 class="mb-9 text-lg font-semibold text-white">Next steps</h4>
          <ul class="flex flex-col gap-4">
            <li>
              <a class="text-base text-gray-7 hover:text-white" href="/contact?intent=demo#enquiry">
                Book a Demo
              </a>
            </li>
            <li>
              <a class="text-base text-gray-7 hover:text-white" href="/get-started">
                Get Started
              </a>
            </li>
            <li>
              <a class="text-base text-gray-7 hover:text-white" href="/platform">
                Explore the Platform
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-12 border-t border-[#8890A4] border-opacity-40 py-8 lg:mt-[60px]">
    <div class="container">
      <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between md:gap-8">
        <nav
          class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 md:justify-start"
          aria-label="Legal"
        >
          <a
            href="/privacy"
            class="text-base leading-7 tracking-normal text-gray-7 hover:text-white hover:underline"
          >
            Privacy policy
          </a>
          <a
            href="/terms"
            class="text-base leading-7 tracking-normal text-gray-7 hover:text-white hover:underline"
          >
            Terms of service
          </a>
          <a
            href="/cookies"
            class="text-base leading-7 tracking-normal text-gray-7 hover:text-white hover:underline"
          >
            Cookies
          </a>
          <a
            href="/data-request"
            class="text-base leading-7 tracking-normal text-gray-7 hover:text-white hover:underline"
          >
            Data request
          </a>
        </nav>
      </div>
    </div>
  </div>

  <div>
    <span class="absolute left-0 top-0 z-[-1]">
      <img src="/assets/footer/shape-1.svg" alt="" />
    </span>
    <span class="absolute bottom-0 right-0 z-[-1]">
      <img src="/assets/footer/shape-3.svg" alt="" />
    </span>
  </div>
</footer>
