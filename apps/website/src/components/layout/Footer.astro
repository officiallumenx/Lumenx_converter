---
import { PRODUCTS, SITE } from "../../data/lumenx.js";

const contactEmail = "lumenxtech.official@gmail.com";

const platformLinks = PRODUCTS.map((p) => ({
  name: p.shortName,
  href: p.href,
}));

const navigationLinks = [
  { name: "Platform", href: "/platform" },
  { name: "Solutions", href: "/solutions" },
  { name: "Modules", href: "/modules" },
  { name: "Pricing", href: "/pricing" },
  { name: "Downloads", href: "/downloads" },
  { name: "Resources", href: "/resources" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
  { name: "Login", href: "/login" },
];

const legalLinks = [
  { name: "Privacy Policy", href: "/privacy" },
  { name: "Terms of Service", href: "/terms" },
  { name: "Cookies", href: "/cookies" },
  { name: "Data Request", href: "/data-request" },
];
---

<!-- ====== Section 6: Footer Start ====== -->
<footer class="relative z-10 border-t border-stroke bg-white text-body-color dark:border-dark-3 dark:bg-[#090E34] dark:text-gray-7">
  <div class="container py-12 sm:py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Brand & short description -->
      <div class="lg:col-span-4">
        <a href="/" class="mb-4 inline-flex items-center gap-2.5">
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-stroke/60 bg-white p-0.5 shadow-sm dark:border-dark-3">
            <img
              src="/assets/logo/lumenx-mark.png"
              alt=""
              class="h-full w-full object-contain object-center"
              width="36"
              height="36"
              loading="lazy"
              aria-hidden="true"
            />
          </span>
          <span class="font-heading text-xl font-bold tracking-tight text-dark dark:text-white">
            LumenX
          </span>
        </a>
        <p class="mb-5 max-w-[320px] text-sm leading-relaxed text-body-color dark:text-gray-7">
          {SITE.description}
        </p>
        <div class="space-y-1.5 text-sm">
          <p>
            <a
              href={`mailto:${contactEmail}`}
              class="font-medium text-dark transition hover:text-primary dark:text-white/90 dark:hover:text-primary"
            >
              {contactEmail}
            </a>
          </p>
          <p>
            <a
              href={SITE.productionOrigin}
              class="text-body-color transition hover:text-primary dark:text-gray-7 dark:hover:text-white"
            >
              lumenxtech.in
            </a>
          </p>
        </div>
      </div>

      <!-- Ecosystem modules -->
      <div class="lg:col-span-3">
        <h3 class="mb-4 font-heading text-xs font-semibold uppercase tracking-wider text-dark dark:text-white">
          Ecosystem
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            platformLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block text-body-color transition hover:text-primary dark:text-gray-7 dark:hover:text-white"
                >
                  LumenX {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-3">
        <h3 class="mb-4 font-heading text-xs font-semibold uppercase tracking-wider text-dark dark:text-white">
          Navigation
        </h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm sm:grid-cols-1">
          {
            navigationLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block text-body-color transition hover:text-primary dark:text-gray-7 dark:hover:text-white"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal & Support -->
      <div class="lg:col-span-2">
        <h3 class="mb-4 font-heading text-xs font-semibold uppercase tracking-wider text-dark dark:text-white">
          Legal
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block text-body-color transition hover:text-primary dark:text-gray-7 dark:hover:text-white"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-stroke pt-6 text-xs text-body-color dark:border-white/10 dark:text-gray-7 sm:flex-row">
      <p>© {new Date().getFullYear()} {SITE.company}. All rights reserved.</p>
      <p>Connected institutional operations across Web, Android, and Windows.</p>
    </div>
  </div>
</footer>
<!-- ====== Section 6: Footer End ====== -->
