---
interface Props {
  page: any;
}

const { page } = Astro.props;
const gallery = page.gallery || [];
const hasGallery = gallery.length > 0;
---

{
  hasGallery ? (
    <section id="walkthrough" class="py-16 dark:bg-dark lg:py-[100px]">
      <div class="container">
        <div class="mx-auto mb-12 max-w-[640px] text-center lg:mb-16" data-reveal>
          <span class="mb-2 block text-lg font-semibold text-primary">Product walkthrough</span>
          <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]">
            Authentic screens from {page.product.shortName}
          </h2>
          <p class="text-base text-body-color dark:text-dark-6">
            Captions explain what each screen demonstrates. Images keep their natural aspect ratio — nothing important is cropped.
          </p>
        </div>

        <div class="lx-product-gallery mx-auto max-w-[960px]" data-product-gallery data-reveal>
          <div
            class="mb-6 flex flex-wrap justify-center gap-2"
            role="tablist"
            aria-label={`${page.product.name} screenshots`}
          >
            {gallery.map((item, index) => (
              <button
                type="button"
                role="tab"
                id={`gallery-tab-${page.id}-${index}`}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`gallery-panel-${page.id}-${index}`}
                tabindex={index === 0 ? 0 : -1}
                data-gallery-tab
                data-index={index}
                class={`lx-gallery-tab rounded-md px-4 py-2 text-sm font-medium transition ${
                  index === 0
                    ? "bg-primary text-white"
                    : "bg-gray-1 text-dark hover:bg-primary/10 dark:bg-dark-2 dark:text-white"
                }`}
              >
                {item.title}
              </button>
            ))}
          </div>

          {gallery.map((item, index) => (
            <div
              id={`gallery-panel-${page.id}-${index}`}
              role="tabpanel"
              aria-labelledby={`gallery-tab-${page.id}-${index}`}
              data-gallery-panel
              data-index={index}
              hidden={index !== 0}
              class="outline-none"
            >
              <div
                class={`mx-auto overflow-hidden rounded-xl bg-[#E8EEF6] p-3 shadow-1 dark:bg-[#DBE4F0] sm:p-4 ${
                  item.orientation === "portrait" ? "max-w-[360px]" : "max-w-[920px]"
                }`}
              >
                <img
                  src={item.src}
                  alt={item.caption}
                  class="mx-auto block h-auto max-h-[70vh] w-full object-contain"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
              <p class="mx-auto mt-5 max-w-[640px] text-center text-base text-body-color dark:text-dark-6">
                <span class="font-semibold text-dark dark:text-white">{item.title}.</span>
                {" "}
                {item.caption}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : page.screenshotPending ? (
    <section id="walkthrough" class="py-16 dark:bg-dark lg:py-[100px]">
      <div class="container">
        <div class="mx-auto max-w-[640px] rounded-xl border border-stroke bg-gray-1 p-10 text-center dark:border-dark-3 dark:bg-dark-2" data-reveal>
          <h2 class="mb-3 text-2xl font-bold text-dark dark:text-white">Screenshots pending</h2>
          <p class="text-base text-body-color dark:text-dark-6">
            An authentic {page.product.name} interface screenshot is not available in this marketing project yet.
            The capabilities described above are limited to verified platform-operator functions — no fabricated UI is shown.
          </p>
        </div>
      </div>
    </section>
  ) : null
}
