---
interface Props {
  page: any;
}

const { page } = Astro.props;
---

<section class="relative z-10 overflow-hidden bg-primary py-16 lg:py-[100px]">
  <div class="container">
    <div class="mx-auto max-w-[640px] text-center" data-reveal>
      <h2 class="mb-4 text-3xl font-bold text-white md:text-[38px] md:leading-[1.35]">
        {page.cta.title}
      </h2>
      <p class="mx-auto mb-8 max-w-[520px] text-base leading-relaxed text-white/90">
        {page.cta.body}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact?intent=demo#enquiry"
          class="lx-btn inline-flex items-center justify-center rounded-md bg-secondary px-7 py-3 text-base font-medium text-white transition hover:bg-[#0BB489]"
        >
          Book a Demo
        </a>
        <a
          href="/platform"
          class="lx-btn inline-flex items-center justify-center rounded-md border border-white/40 px-7 py-3 text-base font-medium text-white transition hover:bg-white hover:text-dark"
        >
          All products
        </a>
        <a
          href="/get-started"
          class="lx-btn inline-flex items-center justify-center rounded-md px-7 py-3 text-base font-medium text-white underline-offset-4 hover:underline"
        >
          Get started
        </a>
      </div>
    </div>
  </div>
</section>
