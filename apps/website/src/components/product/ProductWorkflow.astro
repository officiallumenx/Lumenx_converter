---
interface Props {
  page: any;
}

const { page } = Astro.props;
const workflows = page.workflows || [];
---

<section id="how-it-works" class="bg-gray-1 py-16 dark:bg-dark-2 lg:py-[100px]">
  <div class="container">
    <div class="mx-auto mb-12 max-w-[640px] text-center lg:mb-16" data-reveal>
      <span class="mb-2 block text-lg font-semibold text-primary">How it works</span>
      <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]">
        Realistic workflows, in order
      </h2>
      <p class="text-base text-body-color dark:text-dark-6">
        Steps below match verified product flows — setup, daily use, and hand-offs to related LumenX apps.
      </p>
    </div>

    <div class="-mx-4 flex flex-wrap" data-stagger>
      {
        workflows.map((flow, index) => (
          <div class="mb-8 w-full px-4 lg:w-1/3">
            <div class="lx-card h-full rounded-xl bg-white p-8 shadow-1 dark:bg-dark">
              <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-base font-bold text-white">
                {index + 1}
              </span>
              <h3 class="mb-3 text-xl font-bold text-dark dark:text-white">{flow.title}</h3>
              <p class="mb-5 text-base text-body-color dark:text-dark-6">{flow.body}</p>
              <ol class="space-y-3">
                {flow.steps.map((step) => (
                  <li class="flex gap-3 text-base text-body-color dark:text-dark-6">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
