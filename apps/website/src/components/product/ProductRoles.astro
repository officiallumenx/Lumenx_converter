---
interface Props {
  page: any;
}

const { page } = Astro.props;
const roles = page.roles || [];
---

<section id="benefits" class="py-16 dark:bg-dark lg:py-[100px]">
  <div class="container">
    <div class="mx-auto mb-12 max-w-[640px] text-center lg:mb-16" data-reveal>
      <span class="mb-2 block text-lg font-semibold text-primary">Benefits by role</span>
      <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]">
        Practical value for the people who use it
      </h2>
      <p class="text-base text-body-color dark:text-dark-6">
        {page.audience}
      </p>
    </div>

    <div class="-mx-4 flex flex-wrap" data-stagger>
      {
        roles.map((role) => (
          <div class="mb-8 w-full px-4 md:w-1/2 lg:w-1/3">
            <div class="lx-card h-full rounded-xl border border-transparent bg-white p-8 shadow-testimonial hover:border-primary/20 dark:bg-dark-2 dark:hover:border-primary/30 sm:p-10">
              <h3 class="mb-2 text-xl font-bold text-dark dark:text-white">{role.title}</h3>
              <p class="mb-5 text-base font-medium text-primary">{role.outcome}</p>
              <ul class="space-y-3">
                {role.points.map((point) => (
                  <li class="flex gap-3 text-base text-body-color dark:text-dark-6">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
