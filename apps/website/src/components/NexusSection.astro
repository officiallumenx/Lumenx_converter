---
const nexusValues = [
  {
    title: "Quality Services",
    description: "Reliable and professional service experiences.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Quick Actions",
    description: "Easy access to important services and requests.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Faster Responses",
    description: "Responsive assistance and timely communication.",
    icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
  },
  {
    title: "Simple Experience",
    description: "Clear navigation and easy-to-use service workflows.",
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z",
  },
  {
    title: "Connected Support",
    description: "A convenient way to access relevant LumenX services.",
    icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z",
  },
];
---

<!-- ====== Central Service Platform: Meet LumenX Nexus Start ====== -->
<section
  id="nexus-platform"
  class="lx-section relative overflow-hidden border-y border-stroke/80 bg-gradient-to-b from-[#F4F7FF] via-white to-[#F8FAFC] dark:border-dark-3 dark:from-[#0B132B] dark:via-[#111928] dark:to-[#0F172A]"
  aria-labelledby="lx-nexus-heading"
>
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Left: Core Positioning & CTA -->
      <div class="lg:col-span-6" data-reveal>
        <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/[0.08] px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.1em] text-primary dark:border-primary/30 dark:bg-primary/20 dark:text-sky-300">
          <span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-sky-400" aria-hidden="true"></span>
          Central Service Platform
        </span>

        <h2 id="lx-nexus-heading" class="lx-section-title mb-3">
          Meet LumenX Nexus
        </h2>

        <p class="mb-3 font-heading text-base font-semibold text-primary dark:text-sky-300 sm:text-lg">
          LumenX Nexus — Your Gateway to Smarter Services.
        </p>

        <p class="mb-4 text-[15px] leading-relaxed text-body-color dark:text-dark-6 sm:text-base">
          One platform. Connected services. Better experiences. Access LumenX services with simple actions, quality delivery and responsive assistance.
        </p>

        <p class="mb-7 text-sm leading-relaxed text-body-color dark:text-dark-6 sm:text-[15px]">
          Experience a smarter way to access LumenX services. Nexus brings service access, quick actions and responsive assistance together to make every interaction simple, efficient and reliable.
        </p>

        <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
          <a
            href="/platform/nexus"
            class="lx-btn inline-flex items-center justify-center rounded-lg bg-primary px-7 py-3.5 text-center font-semibold text-white shadow-sm transition hover:bg-blue-dark"
          >
            Explore Nexus →
          </a>
          <a
            href="/contact"
            class="lx-btn inline-flex items-center justify-center rounded-lg border border-stroke bg-white px-6 py-3.5 text-center font-semibold text-dark transition hover:border-primary hover:text-primary dark:border-dark-3 dark:bg-dark-2 dark:text-white dark:hover:border-primary"
          >
            Contact Support
          </a>
        </div>

        <p class="mt-6 text-xs font-semibold tracking-wide text-dark/80 dark:text-dark-6 sm:text-[13px]">
          LumenX Nexus — Quality Services. Quick Actions. Connected Experiences.
        </p>
      </div>

      <!-- Right: Clean Service Gateway Visual & 5 Key Values -->
      <div class="lg:col-span-6" data-reveal>
        <div class="rounded-2xl border border-primary/20 bg-white p-5 shadow-lg dark:border-dark-3 dark:bg-dark-2 sm:p-7">
          <!-- Gateway flow diagram: Users <-> LumenX Nexus <-> LumenX Services -->
          <div class="mb-6 rounded-xl border border-stroke/80 bg-[#F8FAFC] p-4 dark:border-dark-3 dark:bg-dark sm:p-5">
            <div class="mb-3 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-stroke/60 bg-white p-0.5 shadow-sm dark:border-dark-3">
                  <img
                    src="/assets/logo/lumenx-mark.png"
                    alt=""
                    class="h-full w-full object-contain"
                    width="32"
                    height="32"
                    loading="lazy"
                    aria-hidden="true"
                  />
                </span>
                <div>
                  <span class="block font-heading text-sm font-bold text-dark dark:text-white">
                    LumenX Nexus
                  </span>
                  <span class="block text-[11px] font-medium text-body-color dark:text-dark-6">
                    Connected Service Gateway
                  </span>
                </div>
              </div>
              <span class="rounded-full bg-primary/10 px-2.5 py-1 text-[11px] font-semibold text-primary dark:bg-primary/20 dark:text-sky-300">
                Service Platform
              </span>
            </div>

            <!-- Visual connection: Users -> Nexus Gateway -> LumenX Services -->
            <div class="grid grid-cols-1 items-center gap-2.5 sm:grid-cols-3">
              <div class="rounded-lg border border-stroke bg-white px-3 py-2.5 text-center dark:border-dark-3 dark:bg-dark-2">
                <span class="block text-[11px] font-semibold uppercase tracking-wider text-body-color dark:text-dark-6">
                  Users &amp; Campuses
                </span>
                <span class="mt-0.5 block text-xs font-bold text-dark dark:text-white">
                  Service Requests
                </span>
              </div>

              <div class="rounded-lg border border-primary/30 bg-primary px-3 py-2.5 text-center text-white shadow-sm">
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-white/85">
                  Central Gateway
                </span>
                <span class="mt-0.5 block text-xs font-bold">
                  LumenX Nexus
                </span>
              </div>

              <div class="rounded-lg border border-stroke bg-white px-3 py-2.5 text-center dark:border-dark-3 dark:bg-dark-2">
                <span class="block text-[11px] font-semibold uppercase tracking-wider text-body-color dark:text-dark-6">
                  LumenX Ecosystem
                </span>
                <span class="mt-0.5 block text-xs font-bold text-dark dark:text-white">
                  Services &amp; Support
                </span>
              </div>
            </div>
          </div>

          <!-- 5 Key Values of Nexus -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {
              nexusValues.map((val, index) => (
                <div
                  class:list={[
                    "flex items-start gap-3 rounded-xl border border-stroke/80 bg-white p-3.5 transition-colors hover:border-primary/30 dark:border-dark-3 dark:bg-dark",
                    index === nexusValues.length - 1 && "sm:col-span-2",
                  ]}
                >
                  <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary dark:bg-primary/20 dark:text-sky-300">
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d={val.icon} />
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-heading text-sm font-bold text-dark dark:text-white">
                      {val.title}
                    </h3>
                    <p class="mt-0.5 text-xs leading-relaxed text-body-color dark:text-dark-6 sm:text-[13px]">
                      {val.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Central Service Platform: Meet LumenX Nexus End ====== -->
