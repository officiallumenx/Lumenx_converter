---
const challenges = [
  {
    title: "Disconnected management processes",
    problem: "Admissions, academics, attendance, and fee records live in separate files that never stay in sync.",
    solution: "One shared institutional record powers the office, classrooms, and campus services.",
  },
  {
    title: "Scattered communication",
    problem: "Important notices, homework, and parent updates get lost inside informal chat groups.",
    solution: "Role-based channels deliver announcements and class updates directly to teachers, parents, and students.",
  },
  {
    title: "Manual administrative work",
    problem: "Office staff spend hours re-entering the same student, guardian, and staff details across tools.",
    solution: "Enter records once in Admin and convert accepted applicants or hires in a single click.",
  },
  {
    title: "Limited visibility into daily operations",
    problem: "Leadership has to chase registers and spreadsheets to check attendance, dues, or bus routes.",
    solution: "Live operational dashboards surface daily attendance, fee status, and transport activity at a glance.",
  },
];
---

<!-- ====== Section 2: The Problem and the Solution Start ====== -->
<section
  id="about"
  class="lx-section bg-gray-1 dark:bg-dark-2"
  aria-labelledby="lx-problem-solution-heading"
>
  <div class="container">
    <div class="lx-section-intro mx-auto max-w-[640px] text-center" data-reveal>
      <span class="lx-section-eyebrow">The Problem &amp; The Solution</span>
      <h2 id="lx-problem-solution-heading" class="lx-section-title">
        Replace fragmented tools with one unified workflow.
      </h2>
      <p class="lx-section-lead">
        Most institutions lose hours every week managing disconnected spreadsheets, paper registers, and separate messaging apps. LumenX brings every daily workflow into one structured system.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-6" data-stagger>
      {
        challenges.map((item, idx) => (
          <div
            class="lx-card flex flex-col justify-between rounded-xl border border-stroke bg-white p-5 shadow-1 dark:border-dark-3 dark:bg-dark sm:p-7"
            data-reveal
          >
            <div>
              <div class="mb-3 flex items-center gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-xs font-bold text-primary dark:bg-primary/20 dark:text-white">
                  0{idx + 1}
                </span>
                <h3 class="font-heading text-lg font-bold text-dark dark:text-white sm:text-xl">
                  {item.title}
                </h3>
              </div>
              <p class="mb-4 text-sm leading-relaxed text-body-color dark:text-dark-6 sm:text-[15px]">
                {item.problem}
              </p>
            </div>

            <div class="rounded-lg border border-primary/15 bg-[#F4F7FF] px-4 py-3 dark:border-primary/25 dark:bg-dark-2">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                How LumenX solves it
              </p>
              <p class="mt-1 text-sm font-medium leading-snug text-dark dark:text-white">
                {item.solution}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Authentic visual pairing: Office Console + Mobile Campus Portal -->
    <div
      class="mt-8 grid grid-cols-1 items-center gap-6 rounded-2xl border border-stroke bg-white p-5 shadow-1 dark:border-dark-3 dark:bg-dark sm:mt-10 sm:p-7 lg:grid-cols-12 lg:gap-8"
      data-reveal
    >
      <div class="lg:col-span-5">
        <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-wider text-primary">
          Connected by design
        </span>
        <h3 class="mb-3 font-heading text-xl font-bold text-dark dark:text-white sm:text-2xl">
          Updated in the office. Reflected across campus.
        </h3>
        <p class="mb-5 text-sm leading-relaxed text-body-color dark:text-dark-6 sm:text-base">
          Administrators manage institutional records in <strong>LumenX Admin</strong> while teachers, parents, students, and drivers interact with the exact information relevant to their role.
        </p>
        <a
          href="/platform"
          class="lx-btn inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-dark"
        >
          See How the Platform Works →
        </a>
      </div>

      <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-12 lg:col-span-7">
        <div class="overflow-hidden rounded-xl border border-stroke/80 bg-[#E8EEF6] p-2 sm:col-span-8">
          <img
            src="/assets/about/about-image-01.jpg"
            alt="LumenX Admin console showing campus overview and attendance"
            class="block h-auto w-full rounded-lg object-contain"
            loading="lazy"
            decoding="async"
            width="1918"
            height="1054"
          />
        </div>
        <div class="mx-auto w-full max-w-[180px] overflow-hidden rounded-xl border border-stroke/80 bg-[#E8EEF6] p-2 sm:col-span-4 sm:max-w-none">
          <img
            src="/assets/about/about-image-02.jpg"
            alt="LumenX Connect mobile portal for parents, teachers, and students"
            class="block h-auto w-full rounded-lg object-contain"
            loading="lazy"
            decoding="async"
            width="609"
            height="1301"
          />
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Section 2: The Problem and the Solution End ====== -->
