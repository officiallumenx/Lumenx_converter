<!-- ====== About Section Start -->
<section
  id="about"
  class="bg-gray-1 pt-20 pb-8 dark:bg-dark-2 lg:pt-[120px] lg:pb-[70px]"
>
  <div class="container">
    <div class="wow fadeInUp" data-wow-delay=".2s" data-reveal>
      <div class="-mx-4 flex flex-wrap items-center">
        <div class="w-full px-4 lg:w-1/2">
          <div class="mb-12 max-w-[540px] lg:mb-0">
            <span class="mb-3 block text-lg font-semibold text-primary">About LumenX</span>
            <h2
              class="mb-5 text-3xl font-bold leading-tight text-dark dark:text-white sm:text-[40px] sm:leading-[1.2]"
            >
              Built around the way institutions work.
            </h2>
            <p class="mb-10 text-base leading-relaxed text-body-color dark:text-dark-6">
              Institutes often run academics, fees, attendance, and hiring across spreadsheets, chats, and disconnected tools. LumenX brings those institutional workflows into one connected ecosystem — with each product serving a defined purpose.
              <br /><br />
              Admin anchors day-to-day operations. Connect keeps teachers, parents, and students informed. Transport, Admissions, and Careers extend the same record when you need them. Nexus supports licensing and platform service for operators and groups.
            </p>

            <a
              href="/platform"
              class="lx-btn inline-flex items-center justify-center rounded-md border border-primary bg-primary px-7 py-3 text-center text-base font-medium text-white hover:border-blue-dark hover:bg-blue-dark"
            >
              Explore the Platform
            </a>
          </div>
        </div>

        <div class="w-full px-4 lg:w-1/2">
          <!--
            Intentional composition (grid/flex only — no absolute image offsets):
            1) Admin landscape (primary)
            2) Connect portrait + ecosystem stat (secondary row)
          -->
          <div class="flex flex-col gap-4 sm:gap-5">
            <!-- Native Admin ratio (~16:9) so the full dashboard fills the stage -->
            <div class="overflow-hidden rounded-xl bg-[#E8EEF6] p-2 sm:p-3">
              <img
                src="/assets/about/about-image-01.jpg"
                alt="LumenX Admin dashboard — institute overview and operations"
                class="block h-auto w-full rounded-lg object-contain"
                loading="lazy"
                decoding="async"
                width="1918"
                height="1054"
              />
            </div>

            <div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] sm:gap-5">
              <div class="flex justify-center sm:block">
                <!-- Native Connect ratio so the full phone UI is visible -->
                <div class="w-full max-w-[240px] overflow-hidden rounded-xl bg-[#E8EEF6] p-2 sm:max-w-none sm:p-3">
                  <img
                    src="/assets/about/about-image-02.jpg"
                    alt="LumenX Connect mobile home — parent and student campus view"
                    class="block h-auto w-full rounded-lg object-contain"
                    loading="lazy"
                    decoding="async"
                    width="609"
                    height="1301"
                  />
                </div>
              </div>

              <div
                class="relative flex items-center justify-center overflow-hidden rounded-xl bg-primary px-6 py-10 sm:px-5"
              >
                <div class="relative z-10 text-center">
                  <span class="font-heading block text-5xl font-extrabold leading-none text-white sm:text-[52px]">
                    6
                  </span>
                  <span class="mt-2 block text-base font-semibold text-white">Products</span>
                  <span class="block text-base font-medium text-white/70">in one ecosystem</span>
                </div>
                <span class="pointer-events-none absolute top-0 left-0" aria-hidden="true">
                  <svg width="106" height="144" viewBox="0 0 106 144" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect
                      opacity="0.1"
                      x="-67"
                      y="47.127"
                      width="113.378"
                      height="131.304"
                      transform="rotate(-42.8643 -67 47.127)"
                      fill="url(#paint0_linear_about_lx)"
                    />
                    <defs>
                      <linearGradient
                        id="paint0_linear_about_lx"
                        x1="-10.3111"
                        y1="47.127"
                        x2="-10.3111"
                        y2="178.431"
                        gradientUnits="userSpaceOnUse"
                      >
                        <stop stop-color="white" />
                        <stop offset="1" stop-color="white" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== About Section End -->
