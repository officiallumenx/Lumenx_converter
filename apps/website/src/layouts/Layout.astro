---
import "@fontsource/prata/400.css";
import "../styles/tailwind.css";
import "../styles/typography.css";
import "../styles/section-layout.css";
import "../styles/ecosystem-orbit.css";
import "../styles/motion.css";
/* Enable after dropping licensed files: import "../styles/luma-studio.css"; */

import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import { SITE } from '../data/lumenx.js';

interface Props {
  description: string;
  title: string;
  image?: string;
}

const { description, title, image = '/assets/brand/lumenx-ecosystem.jpg' } = Astro.props;
const fullTitle = title.includes('LumenX') ? title : `${title} | LumenX`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3758F9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{fullTitle}</title>
  </head>
  <body class="font-body">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <style is:global>
      .sticky-header {
        @apply fixed z-[9999] bg-white/80 dark:bg-dark/80 transition;
        backdrop-filter: blur(5px);
        box-shadow: inset 0 -1px 0 0 rgba(0, 0, 0, 0.1);
      }

      .sticky-header .navbar-logo {
        @apply py-3;
      }

      .sticky-header .navbar-logo .header-logo {
        height: 100%;
        width: 100%;
      }

      .sticky-header #navbarToggler span {
        @apply bg-dark dark:bg-white;
      }

      .sticky-header #navbarCollapse li > a {
        @apply text-dark dark:text-white hover:text-primary dark:hover:text-primary hover:opacity-100;
      }
      #navbarCollapse li .ud-menu-scroll.active {
        @apply opacity-70;
      }
      .sticky-header #navbarCollapse li .ud-menu-scroll.active {
        @apply text-primary opacity-100;
      }
      .sticky-header .loginBtn,
      .sticky-header a[href="/contact"] {
        @apply text-dark dark:text-white hover:text-primary dark:hover:text-primary hover:bg-transparent;
      }

      .sticky-header .signUpBtn {
        @apply bg-primary text-white hover:bg-blue-dark hover:text-white;
      }

      .sticky-header .lx-theme-btn {
        @apply border-stroke bg-white text-dark hover:border-primary/40 hover:text-primary dark:border-dark-3 dark:bg-dark-2 dark:text-white;
      }

      .navbarTogglerActive > span:nth-child(1) {
        @apply top-[7px] rotate-45 transform;
      }
      .navbarTogglerActive > span:nth-child(2) {
        @apply opacity-0;
      }
      .navbarTogglerActive > span:nth-child(3) {
        @apply top-[-8px] rotate-[135deg];
      }
    </style>
    <script>
      import "../scripts/reveal.js";
      import "../scripts/faq.js";
      import "../scripts/stickymenu.js";
      import "../scripts/dropdown.js";
      import "../scripts/darkMode.js";
      import "../scripts/scrolltop.js";
      import "../scripts/scrollmenu.js";
      import "../scripts/smoothscroll.js";
    </script>
  </body>
</html>
