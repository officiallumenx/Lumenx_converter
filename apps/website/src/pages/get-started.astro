---
import ContentPage from "../components/ContentPage.astro";
import Layout from "../layouts/Layout.astro";
import { PRICING } from "../data/lumenx.js";
---

<Layout
  description={`Start with the LumenX School ERP & Institute Management System: book a demo, complete verification, enjoy a ${PRICING.trialDays}-day free trial, then go live with your school or institute.`}
  title="Get Started with LumenX School ERP & Institute Platform"
>
  <ContentPage
    title="Get started"
    description="Four simple steps to bring your school onto LumenX — starting with a friendly walkthrough and a 60-day free trial."
    showCta={false}
  >
    <ol class="space-y-10">
      <li class="rounded-xl bg-gray-1 p-8 dark:bg-dark-2">
        <span class="mb-2 block text-sm font-semibold text-primary">Step 1</span>
        <h3 class="mb-3 text-xl font-bold text-dark dark:text-white">Book a live walkthrough</h3>
        <p class="mb-4 text-base text-body-color dark:text-dark-6">
          Share a few details about your school and what you'd like to simplify. Our team will walk you through Admin, Connect, and any other apps your campus needs.
        </p>
        <a href="/contact?intent=demo#enquiry" class="font-medium text-primary hover:underline">Book a demo →</a>
      </li>
      <li class="rounded-xl bg-gray-1 p-8 dark:bg-dark-2">
        <span class="mb-2 block text-sm font-semibold text-primary">Step 2</span>
        <h3 class="mb-3 text-xl font-bold text-dark dark:text-white">Quick school verification</h3>
        <p class="text-base text-body-color dark:text-dark-6">
          We verify your school details and set up a dedicated workspace tailored to your classes, staff, and modules.
        </p>
      </li>
      <li class="rounded-xl bg-gray-1 p-8 dark:bg-dark-2">
        <span class="mb-2 block text-sm font-semibold text-primary">Step 3</span>
        <h3 class="mb-3 text-xl font-bold text-dark dark:text-white">Enjoy your {PRICING.trialDays}-day free trial</h3>
        <p class="text-base text-body-color dark:text-dark-6">
          Your school gets full access for {PRICING.trialDays} days at no cost. When you're ready to continue, your monthly plan is simply your student count × your per-student rate (₹{PRICING.rateMin}+ per student), with a ₹{PRICING.minimumMonthly.toLocaleString("en-IN")}/month minimum for smaller campuses. Choose 3, 6, or 12 months — and get 2 months free on the Annual Plan.
        </p>
        <a href="/pricing" class="mt-4 inline-block font-medium text-primary hover:underline">Calculate your plan →</a>
      </li>
      <li class="rounded-xl bg-gray-1 p-8 dark:bg-dark-2">
        <span class="mb-2 block text-sm font-semibold text-primary">Step 4</span>
        <h3 class="mb-3 text-xl font-bold text-dark dark:text-white">Invite your teachers &amp; parents</h3>
        <p class="text-base text-body-color dark:text-dark-6">
          Your school office shares login details with teachers, parents, students, and bus drivers so everyone can sign in and get started right away.
        </p>
      </li>
    </ol>
    <div class="mt-12 flex flex-wrap justify-center gap-4">
      <a
        href="/contact?intent=demo#enquiry"
        class="inline-flex items-center justify-center rounded-md border border-primary bg-primary px-7 py-3 text-base font-medium text-white transition hover:border-blue-dark hover:bg-blue-dark"
      >
        Book a Demo
      </a>
      <a
        href="/pricing"
        class="inline-flex items-center justify-center rounded-md border border-stroke px-7 py-3 text-base font-medium text-dark transition hover:border-primary hover:text-primary dark:border-dark-3 dark:text-white"
      >
        Pricing
      </a>
    </div>
  </ContentPage>
</Layout>
