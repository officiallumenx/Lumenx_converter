---
import About from '../components/Aboutsection.astro';
import Features from '../components/Features.astro';
import Hero from '../components/Hero.astro';
import Rolessection from '../components/Rolessection.astro';
import Productssection from '../components/Productssection.astro';
import Ecosystemsection from '../components/Ecosystemsection.astro';
import Layout from '../layouts/Layout.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contactsection.astro';
import CTA from '../components/CTAsection.astro';
import Enquirysection from '../components/Enquirysection.astro';
import { SITE } from '../data/lumenx.js';
---

<Layout
  description={SITE.description}
  title="LumenX — One connected ecosystem. Smarter institutions."
>
  <!-- 1. What is LumenX? -->
  <Hero />
  <!-- 2. What problem / how institutions work -->
  <About />
  <!-- 3–4. Products and how each helps -->
  <Productssection />
  <Ecosystemsection />
  <Features />
  <!-- 5. Who each experience is for -->
  <Rolessection />
  <!-- 6. Pricing -->
  <PricingCalculator />
  <Faq />
  <!-- 7. What to do next -->
  <CTA />
  <Enquirysection />
  <Contact />
</Layout>
