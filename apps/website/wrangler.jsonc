{
  "compatibility_date": "2025-09-24",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumenx-website",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/server/server.js",
  "vars": {
    "LEAD_EMAIL_TO": "lumenxtech.official@gmail.com",
    "LEAD_FORMSUBMIT": "false"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "no_bundle": true
}
