# LumenX Careers — environment template
#
# Copy to apps/careers/.env for local overrides.
# Vite embeds VITE_* at build time.

# Public app URL (production: https://careers.lumenx.app)
VITE_PUBLIC_APP_URL=

# Auth mode: demo (localStorage) | api (Supabase + /api/v1/me)
VITE_CAREERS_AUTH_MODE=demo

# Backend API (required when VITE_CAREERS_AUTH_MODE=api)
VITE_API_BASE_URL=

# Supabase Auth (required when VITE_CAREERS_AUTH_MODE=api)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
