{
  "name": "@lumenx/app-nexus",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ../../scripts/prepare-cf-worker-deploy.mjs",
    "build:capacitor": "node scripts/sync-app-version.mjs && vite build --config vite.config.capacitor.ts --mode capacitor && node ../../packages/capacitor/scripts/flatten-capacitor-dist.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "cf:upload": "wrangler versions upload --config dist/server/wrangler.json",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:add:android": "npx cap add android",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "cap:apk": "npm run build:capacitor && npx cap sync android && npm run android:apk",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:billing-calc": "tsx src/lib/billing/billing-calc.selftest.ts",
    "test:billing-invoice": "tsx src/lib/billing/billing-invoice.selftest.ts",
    "test:billing-renewals": "tsx src/lib/billing/billing-renewals.selftest.ts",
    "test:billing-history": "tsx src/lib/billing/billing-history.selftest.ts",
    "test:subscription-pricing": "tsx ../../packages/utils/src/subscription/pricing.selftest.ts",
    "test:subscription-lifecycle": "tsx ../../packages/utils/src/subscription/lifecycle.selftest.ts",
    "test": "vitest run",
    "test:registrations": "vitest run src/lib/registrations",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/status-bar": "^7.0.6",
    "@cloudflare/vite-plugin": "^1.25.5",
    "@lumenx/config": "*",
    "@lumenx/auth": "*",
    "@lumenx/capacitor": "*",
    "@lumenx/module-certificates": "*",
    "@lumenx/notifications": "*",
    "@lumenx/ui": "*",
    "@lumenx/ui-admin": "*",
    "@lumenx/utils": "*",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "lucide-react": "^0.575.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "@lumenx/legal": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@lovable.dev/vite-tanstack-config": "^1.7.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  },
  "version": "1.0.0"
}
