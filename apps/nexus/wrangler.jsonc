{
  "compatibility_date": "2025-09-24",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumenx-nexus",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/server/server.js",
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  }
}
