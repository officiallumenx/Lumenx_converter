# LumenX Nexus — environment template (Vite build-time variables)
#
# Copy to apps/nexus/.env (or set in your CI/hosting build environment).

# demo (default) = local/offline registration queue
# api            = Supabase Auth + live /api/nexus (required for production review)
VITE_NEXUS_AUTH_MODE=demo

# Backend public origin (no trailing slash)
VITE_API_BASE_URL=

# Supabase Auth (required when VITE_NEXUS_AUTH_MODE=api)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
