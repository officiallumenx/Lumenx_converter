# LumenX Admin — environment template (Vite build-time variables)
#
# Copy to apps/admin/.env (or set in your CI/hosting build environment).
# Vite embeds VITE_* values at build time — rebuild after changing them.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or other server secrets here.
# Admin may only use the browser-safe Supabase anon key.

# ── Auth mode ───────────────────────────────────────────────────────
# api (default)  = Supabase Auth + live Admin API (required for production)
# demo           = local/offline workflows only
VITE_ADMIN_AUTH_MODE=api

# ── Live API (required when VITE_ADMIN_AUTH_MODE=api) ───────────────
# Backend public origin only (no trailing slash). Do not leave the local
# default in production builds.
# Example shape: https://api.example.com
VITE_API_BASE_URL=http://127.0.0.1:8787

# ── Supabase Auth (required when VITE_ADMIN_AUTH_MODE=api) ──────────
# Project URL and anon (public) key only — never a service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Optional portal links ───────────────────────────────────────────
# Connect (student/parent/teacher/admissions) and standalone Careers app.
VITE_CONNECT_ORIGIN=http://localhost:5174
VITE_CONNECT_PUBLIC_URL=http://localhost:5174
VITE_CAREERS_ORIGIN=http://localhost:5176
VITE_ADMISSIONS_ORIGIN=http://localhost:5177
