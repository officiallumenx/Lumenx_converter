# LumenX Admin — environment template (Vite build-time variables)
#
# Copy to apps/admin/.env (or set in your CI/hosting build environment).
# Vite embeds VITE_* values at build time — rebuild after changing them.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or other server secrets here.
# Admin may only use the browser-safe Supabase anon key.

# ── Auth mode (API only) ────────────────────────────────────────────
# Demo Mode is no longer supported. Only "api" (or omit) is accepted.
# Setting this to "demo" will fail at boot.
VITE_ADMIN_AUTH_MODE=api

# Interactive identity provider — Supabase only
VITE_AUTH_PROVIDER=supabase

# ── Live API (required) ─────────────────────────────────────────────
# Backend public origin only (no trailing slash). Do not leave the local
# default in production / Play Store Capacitor builds.
# Local: http://127.0.0.1:8787
# Production: https://api.lumenxtech.in
VITE_API_BASE_URL=https://api.lumenxtech.in

# ── Supabase Auth (required) ────────────────────────────────────────
# Project URL and anon (public) key only — never a service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Firebase web client (FCM / Analytics / Crashlytics — not Auth) ─
# Public web config only — NEVER put FIREBASE_PRIVATE_KEY / client email here.
VITE_FIREBASE_API_KEY=AIzaSyBl3yrf7F19CvhJBx_awMfUh7WvfyrsYc0
VITE_FIREBASE_AUTH_DOMAIN=lumenx-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lumenx-2026
VITE_FIREBASE_APP_ID=1:197601219106:web:8b1270e698960f3e99307b

# FCM web push (optional; required for browser push)
VITE_FIREBASE_MESSAGING_SENDER_ID=197601219106
VITE_FIREBASE_VAPID_KEY=BCttYAP_J2kyBaEKOlVdy4Lk3NXEUs_bt1025eO__ioQFUCk0ACvWlG4_s_gJ7wy8Hp2UlLMK93JzH5-6TiWeIU

# Analytics (GA4 measurement id) — product telemetry only, no business PII
VITE_FIREBASE_MEASUREMENT_ID=

# Crashlytics / web error client
# true|false — default enables when Firebase web config is present
VITE_FIREBASE_CRASHLYTICS_ENABLED=
# Build/release id for crash breadcrumbs (e.g. gitSha@version)
VITE_APP_RELEASE=

# Optional Firebase init field only (not Firebase Storage for LumenX data)
VITE_FIREBASE_STORAGE_BUCKET=lumenx-2026.firebasestorage.app

# ── Optional portal links ───────────────────────────────────────────
# Connect (student/parent/teacher/admissions) and standalone Careers app.
VITE_CONNECT_ORIGIN=http://localhost:5174
VITE_CONNECT_PUBLIC_URL=http://localhost:5174
VITE_CAREERS_ORIGIN=http://localhost:5176
VITE_ADMISSIONS_ORIGIN=http://localhost:5177
