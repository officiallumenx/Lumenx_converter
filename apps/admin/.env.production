# Production / Cloudflare web builds — overrides local .env API origin.
VITE_ADMIN_AUTH_MODE=api
VITE_AUTH_PROVIDER=supabase
VITE_API_BASE_URL=https://api.lumenxtech.in
# VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY must be present in the Cloudflare
# Workers Builds environment (not committed). Without them the web app cannot auth.
